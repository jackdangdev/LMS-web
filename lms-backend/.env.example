# ---------------------------------------------------------------
# EduNova LMS - environment configuration (copy to .env)
# ---------------------------------------------------------------
NODE_ENV=development
PORT=5000

# MongoDB Atlas (recommended) - replace placeholders with your cluster credentials
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/edunova_lms

# Local MongoDB alternative (uncomment and comment the Atlas line above)
# MONGO_URI=mongodb://127.0.0.1:27017/edunova_lms

# JSON Web Token
JWT_SECRET=edunova_super_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# CORS origin for the (future) front-end
CLIENT_ORIGIN=http://localhost:3000
